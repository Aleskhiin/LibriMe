# Database Configuration
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=test_pass

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=user
RABBITMQ_PASSWORD=user

# Storage Configuration
# Options: local, gcs
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./files
GCS_BUCKET_NAME=your-gcs-bucket-name

# Messaging Configuration
# Options: rabbitmq, pubsub
MESSAGING_PROVIDER=rabbitmq
PUBSUB_TOPIC=new-jobs

# JWT Configuration
# Generate a secret with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long
JWT_EXPIRATION=86400000

# Google/GCP Project ID (for Google Cloud Identity Platform OAuth validation)
GCP_PROJECT_ID=your_gcp_project_id_here

