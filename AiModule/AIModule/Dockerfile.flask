
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # hilft der Phonemizer-Suche nach espeak-ng:
    PHONEMIZER_ESPEAK_LIBRARY=/usr/lib/x86_64-linux-gnu/libespeakng.so.1 \
    # Coqui TTS Standardcache (wir nutzen ihn, um Modelle zu sammeln)
    TTS_HOME=/root/.local/share/tts

WORKDIR /app

# System-Dependencies in EINEM Layer:
# - ffmpeg: Audio I/O
# - git: optional, aber praktisch
# - espeak-ng + libespeak-ng1: für phonemizer (de/en)
# - tesseract-ocr + libtesseract-dev: wie gefordert
# - locales: optional, falls Locale/Tokenizer-Probleme
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git \
    espeak-ng libespeak-ng1 \
    tesseract-ocr libtesseract-dev \
    locales \
  && sed -i 's/# *de_AT.UTF-8 UTF-8/de_AT.UTF-8 UTF-8/' /etc/locale.gen \
  && sed -i 's/# *de_DE.UTF-8 UTF-8/de_DE.UTF-8 UTF-8/' /etc/locale.gen \
  && sed -i 's/# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
  && locale-gen \
  && rm -rf /var/lib/apt/lists/*

ENV LANG=de_AT.UTF-8 \
    LANGUAGE=de_AT:de:en \
    LC_ALL=de_AT.UTF-8

# Python-Dependencies
COPY requirements.txt /app/requirements.txt

# Nutze BuildKit-Pip-Cache; Upgrade pip und installiere Requirements
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip \
 && python -m pip install -r /app/requirements.txt

# Coqui TTS – explizit installieren (optional: Version pinnen)
# (Hinweis: torch/torchaudio werden von TTS mitgebracht; für CPU passt das.)
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install "TTS>=0.22.0"

# --- Modelle bei Buildzeit ziehen (schneller Start, größeres Image) ---

# Dedizierte Modell-Ordner
RUN mkdir -p /app/models/ljspeech /app/models/thorsten

# Lade Modelle per CLI (legt Dateien im $TTS_HOME ab)
# Danach kopieren wir .pth + config.json gezielt in /app/models/...
RUN tts --model_name "tts_models/de/thorsten/tacotron2-DDC" \
        --text "Test" \
        --out_path /app/test_de.wav && \
    tts --model_name "tts_models/en/ljspeech/tacotron2-DDC" \
        --text "Test" \
        --out_path /app/test_en.wav && \
    # LJSpeech (Tacotron2-DDC)
    find "$TTS_HOME" -type f -path "*/tts_models/*/en/*/ljspeech/*/tacotron2-DDC/*" \
        \( -name "*.pth" -o -name "config.json" \) -exec cp -v {} /app/models/ljspeech/ \; && \
    # Thorsten (Tacotron2-DDC)
    find "$TTS_HOME" -type f -path "*/tts_models/*/de/*/thorsten/*/tacotron2-DDC/*" \
        \( -name "*.pth" -o -name "config.json" \) -exec cp -v {} /app/models/thorsten/ \; && \
    # Thorsten Vocoder (HiFi-GAN v1)
    find "$TTS_HOME" -type f -path "*/vocoder_models/*/de/*/thorsten/*/hifigan_v1/*" \
        \( -name "*.pth" -o -name "config.json" \) -exec cp -v {} /app/models/thorsten/ \;

# App-Code zuletzt kopieren (bessere Layer-Caches, wenn Code sich ändert)
COPY . /app

# Optional: Non-root User für Sicherheit (nur wenn Dateirechte passen)
# RUN useradd -m appuser && chown -R appuser:appuser /app
# USER appuser

ENV PYTHONPATH=/app

EXPOSE 5000

CMD ["python3", "localapp.py"]
